---
import { Image } from "astro:assets";
import bmw from "../../public/images/bmw.jpg";
import "../styles/global.css";

const photos = [bmw, bmw, bmw, bmw, bmw, bmw];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
        <meta name="description" content="2012 Jeep Grand Cherokee for sale in Madison, WI — $7,500. 150,200 miles, automatic, 4WD." />
        <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
        <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
        <meta name="generator" content={Astro.generator} />
        <title>2012 Jeep Grand Cherokee — $7,500 · Madison, WI</title>
    </head>
    <body>
        <nav class="nav">
            <div class="container">
                <a href="#" class="nav-logo">driveway</a>
            </div>
        </nav>

        <div class="container">
            <section class="hero-section">
                <p class="label">For sale · Madison, WI</p>
                <h1>2012 Jeep Grand Cherokee</h1>
                <p class="subtitle">Well kept and ready to drive home.</p>
                <a href="tel:6086096342" class="btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.59 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.56a16 16 0 0 0 5.93 5.93l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    Call the seller
                </a>
            </section>

            <hr class="divider" />

            <section class="section">
                <p class="eyebrow">6 PHOTOS</p>
                <h2 class="section-heading">See it up close.</h2>
                <div id="photo-grid" class="photo-grid">
                    {photos.map((photo, i) => (
                        <Image
                            src={photo}
                            alt={`Vehicle photo ${i + 1}`}
                            class:list={["grid-photo", i >= 4 && "extra-photo"]}
                            width={600}
                            height={600}
                            loading={i === 0 ? "eager" : "lazy"}
                            fetchpriority={i === 0 ? "high" : undefined}
                            decoding={i === 0 ? "sync" : "async"}
                        />
                    ))}
                </div>
                <button id="see-all-btn" class="see-all-btn">See all →</button>

                <!-- Lightbox -->
                <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
                    <button id="lb-close" class="lb-close" aria-label="Close">×</button>
                    <button id="lb-prev" class="lb-nav lb-prev-desktop" aria-label="Previous photo">←</button>
                    <div class="lb-content">
                        <img id="lb-img" src="" alt="" class="lb-img" />
                        <div class="lb-toolbar">
                            <button id="lb-prev-inline" class="lb-nav-inline" aria-label="Previous photo">←</button>
                            <a href="tel:6086096342" class="btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.59 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.56a16 16 0 0 0 5.93 5.93l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                                </svg>
                                Call the seller
                            </a>
                            <span id="lb-count" class="lb-count" aria-live="polite"></span>
                            <button id="lb-next-inline" class="lb-nav-inline" aria-label="Next photo">→</button>
                        </div>
                    </div>
                    <button id="lb-next" class="lb-nav lb-next-desktop" aria-label="Next photo">→</button>
                </div>

                <script>
                    const lightbox = document.getElementById('lightbox')!;
                    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
                    const lbCount = document.getElementById('lb-count')!;
                    let photos: HTMLImageElement[] = [];
                    let current = 0;

                    const viewport = document.querySelector('meta[name="viewport"]')!;

                    function openLightbox(index: number) {
                        photos = [...document.querySelectorAll<HTMLImageElement>('.grid-photo')];
                        current = index;
                        lbImg.src = photos[current].src;
                        lbCount.textContent = `${current + 1} / ${photos.length}`;
                        lightbox.classList.add('is-open');
                        document.body.classList.add('no-scroll');
                        viewport.setAttribute('content', 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no');
                    }

                    function closeLightbox() {
                        lightbox.classList.remove('is-open');
                        document.body.classList.remove('no-scroll');
                        viewport.setAttribute('content', 'width=device-width, initial-scale=1, maximum-scale=1');
                    }

                    function navigate(dir: number) {
                        current = (current + dir + photos.length) % photos.length;
                        lbImg.src = photos[current].src;
                        lbCount.textContent = `${current + 1} / ${photos.length}`;
                    }

                    document.getElementById('see-all-btn')!.addEventListener('click', (e) => {
                        document.querySelectorAll('.extra-photo').forEach(el => el.classList.remove('extra-photo'));
                        (e.currentTarget as HTMLElement).style.display = 'none';
                    });

                    document.getElementById('photo-grid')!.addEventListener('click', (e) => {
                        const photo = (e.target as Element).closest<HTMLImageElement>('.grid-photo');
                        if (!photo) return;
                        openLightbox([...document.querySelectorAll<HTMLImageElement>('.grid-photo')].indexOf(photo));
                    });

                    document.getElementById('lb-close')!.addEventListener('click', closeLightbox);
                    document.getElementById('lb-prev')!.addEventListener('click', () => navigate(-1));
                    document.getElementById('lb-next')!.addEventListener('click', () => navigate(1));
                    document.getElementById('lb-prev-inline')!.addEventListener('click', () => navigate(-1));
                    document.getElementById('lb-next-inline')!.addEventListener('click', () => navigate(1));
                    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });

                    document.addEventListener('keydown', (e) => {
                        if (!lightbox.classList.contains('is-open')) return;
                        if (e.key === 'ArrowLeft') navigate(-1);
                        else if (e.key === 'ArrowRight') navigate(1);
                        else if (e.key === 'Escape') closeLightbox();
                    });

                    let touchStartX = 0;
                    lightbox.addEventListener('touchstart', (e) => {
                        touchStartX = e.touches[0].clientX;
                    }, { passive: true });
                    lightbox.addEventListener('touchend', (e) => {
                        const dx = e.changedTouches[0].clientX - touchStartX;
                        if (Math.abs(dx) > 50) navigate(dx < 0 ? 1 : -1);
                    }, { passive: true });
                </script>
            </section>

            <hr class="divider" />

            <section class="section">
                <p class="eyebrow">PRICE</p>
                <div class="price">$7,500</div>
            </section>

            <hr class="divider" />

            <section class="section">
                <p class="eyebrow">INFO</p>
                <h2 class="section-heading">The details.</h2>
            </section>

            <section class="specs">
                {[
                    { label: "MILEAGE", value: "150,200 mi" },
                    { label: "TRANSMISSION", value: "Automatic" },
                    { label: "FUEL", value: "Gasoline" },
                    { label: "DRIVETRAIN", value: "4WD" },
                    { label: "COLOR", value: "Black" },
                    { label: "TITLE", value: "—" },
                    { label: "OWNERS", value: "2" },
                    { label: "VIN", value: "1C4RJFBG1CC106350" },
                ].map(({ label, value }) => (
                    <dl class="spec-item">
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                    </dl>
                ))}
            </section>
        </div>
    </body>
</html>
